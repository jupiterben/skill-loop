{
  "name": "loop",
  "version": "0.2.0",
  "description": "CLI + dashboard for Loop Engineering project runtime state (JSON file store)",
  "type": "module",
  "main": "./dist/cli/cli.js",
  "bin": {
    "loop": "./dist/cli/cli.js"
  },
  "files": [
    "dist",
    "public",
    "templates"
  ],
  "scripts": {
    "build": "tsc && pnpm build:dashboard",
    "build:dashboard": "pnpm check:dashboard && vite build --config src/dashboard/vite.config.ts",
    "check:dashboard": "svelte-check --tsconfig src/dashboard/tsconfig.json",
    "dev": "vite --config src/dashboard/vite.config.ts",
    "prepack": "pnpm build",
    "test:cli": "vitest run --config vitest.config.ts",
    "test:dashboard:e2e": "pnpm build && playwright test --config src/dashboard/playwright.config.ts",
    "test:all": "vitest run --config src/dashboard/vitest.config.ts && vitest run --config vitest.config.ts",
    "test": "pnpm test:all",
    "dashboard": "node dist/cli/cli.js dashboard",
    "dashboard:fg": "node dist/cli/cli.js dashboard --foreground",
    "loop": "node dist/cli/cli.js",
    "loop:dev": "tsx src/cli/cli.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.1.0",
    "@xyflow/svelte": "1.7.0",
    "@xyflow/system": "0.0.83",
    "@playwright/test": "^1.56.0",
    "lucide-svelte": "^0.468.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.3.0",
    "tsx": "4.20.5",
    "typescript": "~6.0.0",
    "vite": "8.1.3",
    "vitest": "^5.0.2"
  }
}
